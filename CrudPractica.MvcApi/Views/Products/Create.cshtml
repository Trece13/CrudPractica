@model CrudPractica.Application.DTOs.CreateProductDto

@{
    ViewData["Title"] = "Crear producto";
}

<h1>Crear producto</h1>

<hr />

<div class="row">
    <div class="col-md-6">

        <form asp-action="Create" method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger">
            </div>


            <!-- NOMBRE -->
            <div class="form-group mb-3">

                <label asp-for="Name"
                       class="control-label">
                </label>

                <input asp-for="Name"
                       class="form-control" />

                <span asp-validation-for="Name"
                      class="text-danger">
                </span>

            </div>


            <!-- DESCRIPCIÓN -->
            <div class="form-group mb-3">

                <label asp-for="Description"
                       class="control-label">
                </label>

                <input asp-for="Description"
                       class="form-control" />

                <span asp-validation-for="Description"
                      class="text-danger">
                </span>

            </div>


            <!-- PRECIO -->
            <div class="form-group mb-3">

                <label asp-for="Price"
                       class="control-label">
                </label>

                <input asp-for="Price"
                       class="form-control" />

                <span asp-validation-for="Price"
                      class="text-danger">
                </span>

            </div>


            <!-- CANTIDAD -->
            <div class="form-group mb-3">

                <label asp-for="Quantity"
                       class="control-label">
                </label>

                <input asp-for="Quantity"
                       class="form-control" />

                <span asp-validation-for="Quantity"
                      class="text-danger">
                </span>

            </div>


            <!-- CATEGORÍAS -->
            <div class="form-group mb-3">

                <label class="control-label">
                    Categorías
                </label>

                @foreach (var category in ViewBag.Categories)
                {
                    bool selected =
                    Model.CategoryIds.Contains(category.Id);

                    <div class="form-check">

                        <input type="checkbox"
                               name="CategoryIds"
                               value="@category.Id"
                               checked="@selected"
                               class="form-check-input" />

                        <label class="form-check-label">
                            @category.Name
                        </label>

                    </div>
                }

            </div>


            <!-- BOTÓN -->
            <div class="form-group">

                <input type="submit"
                       value="Crear"
                       class="btn btn-primary" />

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Volver
                </a>

            </div>

        </form>

    </div>
</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }
}