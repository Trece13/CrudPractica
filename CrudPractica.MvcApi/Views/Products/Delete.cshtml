@model CrudPractica.Application.DTOs.ProductResponseDto

@{
    ViewData["Title"] = "Eliminar producto";
}

<h1>Eliminar producto</h1>

<h3>
    ¿Está seguro de eliminar este producto?
</h3>

<hr />

<dl class="row">

    <dt class="col-sm-2">
        Nombre
    </dt>

    <dd class="col-sm-10">
        @Model.Name
    </dd>


    <dt class="col-sm-2">
        Descripción
    </dt>

    <dd class="col-sm-10">
        @Model.Description
    </dd>


    <dt class="col-sm-2">
        Precio
    </dt>

    <dd class="col-sm-10">
        @Model.Price
    </dd>


    <dt class="col-sm-2">
        Cantidad
    </dt>

    <dd class="col-sm-10">
        @Model.Quantity
    </dd>


    <dt class="col-sm-2">
        Categorías
    </dt>

    <dd class="col-sm-10">

        @if (Model.Categories.Any())
        {
            @foreach (var category in Model.Categories)
            {
                <span class="badge bg-secondary">
                    @category.Name
                </span>
            }
        }
        else
        {
            <span>Sin categorías</span>
        }

    </dd>

</dl>


<form asp-action="Delete"
      method="post">

    <input type="hidden"
           asp-for="Id" />

    <input type="submit"
           value="Eliminar"
           class="btn btn-danger" />

    <a asp-action="Index"
       class="btn btn-secondary">
        Volver
    </a>

</form>