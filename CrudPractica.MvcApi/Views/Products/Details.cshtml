@model CrudPractica.Application.DTOs.ProductResponseDto

@{
    ViewData["Title"] = "Detalle del producto";
}

<h1>Detalle del producto</h1>

<hr />

<dl class="row">

    <dt class="col-sm-2">
        Nombre
    </dt>

    <dd class="col-sm-10">
        @Model.Name
    </dd>


    <dt class="col-sm-2">
        Descripción
    </dt>

    <dd class="col-sm-10">
        @Model.Description
    </dd>


    <dt class="col-sm-2">
        Precio
    </dt>

    <dd class="col-sm-10">
        @Model.Price
    </dd>


    <dt class="col-sm-2">
        Cantidad
    </dt>

    <dd class="col-sm-10">
        @Model.Quantity
    </dd>


    <dt class="col-sm-2">
        Categorías
    </dt>

    <dd class="col-sm-10">

        @if (Model.Categories.Any())
        {
            <ul>

                @foreach (var category in Model.Categories)
                {
                    <li>
                        @category.Name
                    </li>
                }

            </ul>
        }
        else
        {
            <span>
                Sin categorías
            </span>
        }

    </dd>

</dl>


<div>

    <a asp-action="Edit"
       asp-route-id="@Model.Id"
       class="btn btn-primary">
        Editar
    </a>

    <a asp-action="Index"
       class="btn btn-secondary">
        Volver
    </a>

</div>